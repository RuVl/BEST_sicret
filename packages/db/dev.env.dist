# Локальные оверрайды для alembic вне docker (make migrate / migration / downgrade).
#
# Грузится поверх postgres/.env: `uv run --env-file ../../postgres/.env --env-file dev.env`,
# последний --env-file приоритетнее. В postgres/.env хост — имя сервиса compose
# (`postgres`), а с хоста БД доступна на localhost (docker-compose.dev.yaml).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === TelegramKeys ===
TG_API_TOKEN='api-key'

# === ProjectKeys ===
DEBUG=False

# dirs
RESOURCE_DIR=resources/
TEMPLATES_DIR=resources/templates/
REFUND_BILLS_DIR=resources/refund_bills/

# locale
LOCALE_DIR=l10n/
AVAILABLE_LOCALES=ru

# === XuiKeys (панель 3x-ui, выдача VPN-подписок) ===
XUI_BASE_URL=https://example.com/basePath
XUI_API_TOKEN='xui-api-token'
XUI_SUB_BASE_URL=https://vpn.example.org/sub

# ID inbound'ов, к которым цепляется новый клиент (через запятую)
XUI_INBOUND_IDS=1
XUI_GROUP='SPb LBG members'
XUI_CLIENT_IP_LIMIT=3
XUI_TRAFFIC_RESET_DAYS=30

# Отзыв подписок у выбывших мемберов (после синка members_sync в 03:00)
VPN_REVOKE_CRON_HOUR=4
VPN_REVOKE_CRON_MINUTE=0
VPN_REVOKE_CRON_TIMEZONE='Europe/Moscow'

# === AwgKeys (AmneziaWG-инбаунд в той же панели 3x-ui, что и VLESS; 0 - функция выключена) ===
AWG_INBOUND_ID=0
# Адрес в Endpoint конфига; пусто - Listen IP инбаунда. Только IP или домен без CDN: Cloudflare не пускает UDP
AWG_ENDPOINT_HOST=
AWG_GROUP='SPb LBG AmneziaWG'
AWG_TUNNEL_NAME=BEST-AWG
# Устройств на человека по умолчанию (один ключ AmneziaWG - одно устройство)
AWG_DEVICE_LIMIT=3
# Через сколько секунд бот уберёт из чата сообщение с конфигом (там приватный ключ)
AWG_CONFIG_TTL_SECONDS=300

# === LoggerKeys (optional) ===
SHOW_DEBUG_LOGS=False

SHOW_DATETIME=True
DATETIME_FORMAT='%Y-%m-%d %H:%M:%S'
TIME_IN_UTC=True

USE_COLORS_IN_CONSOLE=True

LOG_TO_FILE=True
LOG_FILE_PATH=logs/bot.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
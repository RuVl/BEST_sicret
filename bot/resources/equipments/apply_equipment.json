{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Заявка на выдачу предметов из базы имущества",
  "description": "Для оформления заявки Вам необходимо заполнить следующие данные:",
  "type": "object",
  "properties": {
    "decree_date": {
      "type": "string",
      "format": "date",
      "description": "Дата заполнения",
      "question": "Введите дату заполнения (в формате: ДД.ММ.ГГГГ):"
    },
    "surname_user": {
      "type": "string",
      "description": "Фамилия",
      "question": "Введите свою фамилию"
    },
    "name_user": {
      "type": "string",
      "description": "Имя",
      "question": "Введите свое имя"
    }
  },
  "required": [
    "decree_date",
    "surname_user",
    "name_user"
  ]
}
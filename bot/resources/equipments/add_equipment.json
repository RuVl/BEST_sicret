{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Добавление имущества в базу",
  "description": "Для добавления имущества заполните следующие поля:",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Название имущества",
      "question": "Введите название имущества:"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "description": "Количество",
      "question": "Введите количество:"
    },
    "unit": {
      "type": "string",
      "description": "Единица измерения ",
      "question": "Введите единицу измерения:"
    }

  },
  "required": [
    "name",
    "count",
    "unit"
  ]
}
# Локальные оверрайды для запуска бота вне docker (make run-bot).
#
# Грузится поверх .env: `uv run --env-file dev.env` кладёт эти переменные в
# окружение процесса, а у pydantic-settings реальное окружение приоритетнее .env.
# Поэтому здесь держим только то, что на хосте отличается от docker-конфига (.env).

# В compose бот ходит на хосты `postgres`/`redis` (имена сервисов в сети
# best_backend), а локально они проброшены на localhost (docker-compose.dev.yaml).

# === ProjectKeys ===
DEBUG=True

# === Database ===
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === 3x-ui ===
XUI_BASE_URL=https://example.com/basePath
XUI_API_TOKEN='xui-api-token'
XUI_SUB_BASE_URL=http://localhost:2096/sub
XUI_INBOUND_IDS=1

# === LoggerKeys (optional) ===
SHOW_DEBUG_LOGS=True

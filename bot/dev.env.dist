# Локальные оверрайды для запуска бота вне docker (make run-bot).
#
# Грузится поверх .env: `uv run --env-file dev.env` кладёт эти переменные в
# окружение процесса, а у pydantic-settings реальное окружение приоритетнее .env.
# Поэтому здесь держим только то, что на хосте отличается от docker-конфига (.env).

# В compose бот ходит на хосты `postgres`/`redis` (имена сервисов в сети
# best_backend), а локально они проброшены на localhost (docker-compose.dev.yaml).

# === ProjectKeys ===
DEBUG=True

# Демо-шаблон приказа из git. Настоящие шаблоны лежат в resources/templates (не в git):
# чтобы работать с ними, уберите эту строку.
TEMPLATES_DIR=resources/demo_templates/

# === Database ===
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === 3x-ui ===
# Панель настраивается в .env (что нужно - см. .env.dist). Здесь значения закомментированы, а не пусты:
# пустая переменная окружения перекрыла бы настройки из .env. Раскомментируйте для отдельной тестовой панели.
# XUI_BASE_URL=
# XUI_API_TOKEN=
# XUI_SUB_BASE_URL=
# XUI_INBOUND_IDS=

# === LoggerKeys (optional) ===
SHOW_DEBUG_LOGS=True

# Локальные оверрайды для запуска members_sync вне docker (make run-sync).
#
# Грузится поверх .env: `uv run --env-file dev.env` кладёт эти переменные в
# окружение процесса, а у pydantic-settings реальное окружение приоритетнее .env.
# Поэтому здесь держим только то, что на хосте отличается от docker-конфига (.env).

# В compose сервис ходит на хост `postgres` (имя сервиса в сети best_backend),
# а локально postgres проброшен на localhost:5432 (docker-compose.dev.yaml).

POSTGRES_HOST=localhost
WRITE_SHEET_NOTES=False

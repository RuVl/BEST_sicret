# === GoogleKeys ===
API_CREDENTIALS_FILE='service_account.json'
SPREADSHEET_KEY='1K49LmaqXMNf08YDM2dI5ovL3QgshBjcGFXP4h3oNv3E'

# === SyncKeys ===
# Писать ли заметки об ошибках парсинга прямо в Google-таблицу.
# Требует у сервис-аккаунта право редактирования.
WRITE_SHEET_NOTES=False
# Маркер, которым помечаются заметки сервиса (чтобы снимать только свои).
SHEET_NOTE_MARKER='🤖 [sync]'
# Создавать схему БД на старте (create_all). Отключите, если используете alembic.
AUTO_CREATE_SCHEMA=True
# Куда сохранять отчёт о прогоне и отладочный дамп.
SYNC_REPORT_PATH='last_sync_report.md'
DUMP_JSON_PATH='output/members.json'

# === RunKeys ===
# once  — один прогон и выход (для внешнего планировщика)
# cron  — контейнер живёт постоянно и сам запускается по расписанию
RUN_MODE='once'
CRON_HOUR=3
CRON_MINUTE=0
CRON_TIMEZONE='Europe/Moscow'

# === PostgresKeys ===
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === LoggerKeys ===
DEBUG=True
# Уровень для файла и stdout: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=DEBUG
USE_COLORS_IN_CONSOLE=True

# stdout контейнера (все уровни)
LOG_TO_CONSOLE=True

# файл со всеми уровнями
LOG_TO_FILE=True
LOG_FILE_PATH=logs/members_sync.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5

# markdown-файл только с warning/error
LOG_TO_MD=True
LOG_MD_PATH=logs/warnings.md
LOG_MD_LEVEL=WARNING
